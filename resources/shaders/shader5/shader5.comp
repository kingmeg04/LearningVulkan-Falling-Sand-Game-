#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) uniform ParameterUBO {
    float deltaTime;
} ubo;

struct Particle {
    vec2 position;
    vec2 velocity;
    vec4 color;
};

layout(std140, binding = 1) readonly buffer ParticleSSBOIn  { Particle particlesIn[];  };
layout(std140, binding = 2)          buffer ParticleSSBOOut { Particle particlesOut[]; };

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= particlesIn.length()) return;

    Particle p = particlesIn[index];

    vec2 newPos = p.position + p.velocity * ubo.deltaTime;
    vec2 newVel = p.velocity;

    // Bounce: flip the velocity component and clamp the position back inside
    if (newPos.x <= -1.0 || newPos.x >= 1.0) {
        newVel.x = -newVel.x;
        newPos.x = clamp(newPos.x, -1.0, 1.0);
    }
    if (newPos.y <= -1.0 || newPos.y >= 1.0) {
        newVel.y = -newVel.y;
        newPos.y = clamp(newPos.y, -1.0, 1.0);
    }

    particlesOut[index].position = newPos;
    particlesOut[index].velocity = newVel;
    particlesOut[index].color    = p.color;
}